{
  "name": "cesfam-dashboard-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres:auth-concurrency": "node test/integration/auth-concurrency.integration.js",
    "test:postgres:imports": "node test/integration/imports.integration.js",
    "db:migrate:up": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:seed:synthetic": "node scripts/seed-synthetic-data.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}

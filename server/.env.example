# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Puerto HTTP de la API.
PORT=3000

# Conexión PostgreSQL compartida por la API y el ejecutor de migraciones.
# Cree un rol de aplicación con privilegios mínimos y reemplace esta clave ilustrativa.
DATABASE_URL=postgresql://consultorio_app:change_me@localhost:5432/consultorio_dev

# Nivel de logging: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# Secreto aleatorio de al menos 32 caracteres para firmar la cookie de sesión.
SESSION_SECRET=replace_with_at_least_32_random_characters

# Nombre de la cookie y duración máxima de la sesión (entre 1 y 168 horas).
SESSION_COOKIE_NAME=consultorio.sid
SESSION_TTL_HOURS=8

# Use true solo cuando la API esté detrás de un proxy inverso controlado.
TRUST_PROXY=false
